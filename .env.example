# En desarrollo se dejan ambas sin definir: Vite reenvía /api a json-server.

# Activa el backend simulado en el navegador (localStorage), sin red. Es lo
# que usa el build publicado en GitHub Pages: no hay backend propio.
VITE_API_MODE=demo

# Alternativa a VITE_API_MODE: URL de un backend propio (json-server u otro)
# cuando el frontend y la API no comparten origen. Se ignora si VITE_API_MODE=demo.
VITE_API_URL=https://mi-api-de-ejemplo/api
